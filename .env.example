# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/mwangagrid

# ── Auth ──
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# ── App ──
PORT=3000
NODE_ENV=production

# ── M-Pesa (Daraja) ──
# https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENV=production

# ── Stripe Payments ──
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET_HERE

# ── Email / SMTP ──
# For development, emails are printed to console.
# For production, use a real SMTP server e.g. SendGrid, AWS SES, Resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cheidaniells@gmail.com
SMTP_PASS=
FROM_EMAIL="Mwanga Grid <noreply@mwangagrid.co.ke>"

# ── File Uploads ──
# Uploads stored locally by default.
# For production, configure Cloudinary or S3:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
