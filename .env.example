# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/mwangagrid

# ── Auth / Session ──
SESSION_SECRET=generate_with_powershell:_[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# ── App ──
PORT=3000
NODE_ENV=production

# ── Analytics / SEO ──
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# ── M-Pesa (Daraja) ──
# https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENV=production
MPESA_CALLBACK_URL=https://www.mwangagrid.co.ke/api/mpesa/callback

# ── Email / SMTP ──
# Gmail: enable 2FA → https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cheidaniells@gmail.com
SMTP_PASS=
FROM_EMAIL="Mwanga Grid <noreply@mwangagrid.co.ke>"

# ── File Uploads ──
# Uploads stored locally by default.
# For production, configure Cloudinary or S3:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
